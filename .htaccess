RewriteEngine On

# 1. If someone requests /sign-up (no trailing slash) → redirect to /sign-up/
RewriteCond %{REQUEST_URI} ^/sign-up$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# 2. When /sign-up/ is requested → internally serve sign-up/index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*[^/])$ $1/index.html [L]

DirectoryIndex index.html index.htm

# ── PWA ────────────────────────────────────────────────────────────
# Correct type for the web app manifest, and never let the browser/CDN
# cache the service worker or manifest (so new deploys are picked up).
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
