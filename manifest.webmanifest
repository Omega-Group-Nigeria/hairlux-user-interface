    { "name": "My bookings", "short_name": "Bookings", "url": "./app/my-bookings.html?source=pwa-shortcut", "icons": [{ "src": "assets/img/pwa/icon-maskable-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Rewards", "short_name": "Rewards", "url": "./app/rewards.html?source=pwa-shortcut", "icons": [{ "src": "assets/img/pwa/icon-maskable-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
